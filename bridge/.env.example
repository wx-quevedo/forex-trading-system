# ForexBot Bridge — variables de entorno
# Copia este archivo a `.env` y rellena con las credenciales de tu cuenta MT5 demo.

# --- Credenciales del broker (cuenta DEMO durante desarrollo) ---
MT5_LOGIN=12345678
MT5_PASSWORD=tu_password_demo
MT5_SERVER=ICMarkets-Demo

# Ruta opcional al terminal terminal64.exe. Déjalo vacío para autodetección.
MT5_PATH=

# --- Seguridad del bridge ---
# Clave que el VPS Laravel debe enviar en el header X-API-Key.
# Genera una aleatoria, p.ej.:  python -c "import secrets; print(secrets.token_hex(32))"
BRIDGE_API_KEY=cambia_esta_clave_por_una_aleatoria_larga

# --- Servidor ---
BRIDGE_HOST=0.0.0.0
BRIDGE_PORT=8000

# CORS / acceso. En producción el acceso es solo vía Tailscale.
ALLOWED_ORIGINS=*
